# Copy this file to backend/.env and fill in your own values.
#   cp .env.example .env          (Windows PowerShell: copy .env.example .env)

# ---- MongoDB Atlas (required for accounts, saved papers and analytics) ----
# Atlas -> Cluster -> Connect -> Drivers -> copy the connection string.
# Replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=qpgen

# ---- Login tokens ----
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=72

# ---- Who may call this API ----
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- Optional model overrides ----
# QG_MODEL=valhalla/t5-base-qg-hl
# EMBED_MODEL=all-MiniLM-L6-v2
